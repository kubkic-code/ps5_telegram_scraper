# .env.example — Bazoš Scraper konfigurace
# DevOps Agent | Zkopíruj jako .env a vyplň hodnoty
# NIKDY necommituj .env do gitu!

# --- Telegram Bot (POVINNÉ) ---
# Získej token od @BotFather na Telegramu
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Chat ID platících klientů (čárkou oddělené)
# Zjisti chat_id: pošli zprávu svému botu a GET /getUpdates
TELEGRAM_CHAT_IDS=123456789,987654321

# --- Scraping intervaly (volitelné) ---
# Minimální čekání mezi kontrolami (sekundy)
SCRAPE_INTERVAL_MIN=120
# Maximální čekání mezi kontrolami (sekundy)
SCRAPE_INTERVAL_MAX=300

# --- Logování (volitelné) ---
# Úrovně: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Portály (volitelné) ---
# Zapnout/vypnout Kleinanzeigen.de scraping (true/false)
VINTED_ENABLED=true

# --- Home Assistant Webhook (volitelné) ---
HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/vas_webhook_id

# --- Databáze (volitelné) ---
DB_PATH=/data/market.db
